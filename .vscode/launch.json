        {
            "name": "SDL2, Local",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/isaac-debug",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "Build SDL2, Local",
