{
    "linux-sdl2": {
        "image": "wischner/gcc-x86_64-linux-sdl:latest",
        "cmake": [
            "-DTOOLKIT=SDL2"
        ],
        "run": [
            "env",
            "SDL_VIDEODRIVER=dummy",
            "SDL_RENDER_DRIVER=software"
        ],
        "package": {
            "title": "Linux (SDL2)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "An X11 or Wayland desktop."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-x11": {
        "image": "wischner/gcc-x86_64-linux-x11:latest",
        "cmake": [
            "-DTOOLKIT=X11"
        ],
        "run": [
            "xvfb-run",
            "-a"
        ],
        "session": "x11",
        "package": {
            "title": "Linux (X11, Athena widgets)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "An X11 session (Xorg or XWayland)."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-motif": {
        "image": "wischner/gcc-x86_64-linux-motif:latest",
        "cmake": [
            "-DTOOLKIT=MOTIF"
        ],
        "run": [
            "xvfb-run",
            "-a"
        ],
        "session": "cde-xephyr",
        "package": {
            "title": "Linux (Motif)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "An X11 session (Xorg or XWayland)."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-openlook": {
        "image": "wischner/gcc-x86_64-linux-openlook:latest",
        "cmake": [
            "-DTOOLKIT=OPENLOOK"
        ],
        "run": [
            "xvfb-run",
            "-a"
        ],
        "session": "openlook-xephyr",
        "package": {
            "title": "Linux (OPEN LOOK, XView)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "An X11 session (Xorg or XWayland).",
                "The XView libraries are included in `lib/`."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-wmaker": {
        "image": "wischner/gcc-x86_64-linux-window-maker:latest",
        "cmake": [
            "-DTOOLKIT=WMAKER"
        ],
        "run": [
            "xvfb-run",
            "-a"
        ],
        "session": "window-maker-xephyr",
        "package": {
            "title": "Linux (Window Maker, WINGs)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "An X11 session (Xorg or XWayland).",
                "The WINGs libraries are included in `lib/`."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-gemix-gemd": {
        "image": "wischner/gcc-x86_64-gemix:latest",
        "cmake": [
            "-DTOOLKIT=GEMIX",
            "-DGEMIX_USE_GEMD=ON"
        ],
        "run": [
            "env",
            "GEM_RASTA_INVERSE=off",
            "GEM_RASTA_FRAMEBUFFER=/tmp/isaac.fb",
            "GEM_RASTA_PORT=5044",
            "bash",
            "{native}/scripts/gemix/gemd-session.sh"
        ],
        "session": "gemix",
        "gemd": true,
        "package": {
            "title": "Linux (GEMix)",
            "requires": [
                "64-bit x86 Linux with glibc 2.35 or newer.",
                "A running GEMix `gemd` server. Isaac is a GEM client and connects to the server named by `GEMD_SOCKET`; it does not start one."
            ],
            "run": [
                "Start Isaac from a GEMix session, or point it at the server:",
                "",
                "```sh",
                "GEMD_SOCKET=/path/to/gemd.sock ./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "haiku": {
        "image": "wischner/gcc-x86_64-haiku:1.1.0",
        "cmake": [
            "-DCMAKE_TOOLCHAIN_FILE={native}/scripts/cmake/toolchain-haiku.cmake"
        ],
        "package": {
            "title": "Haiku",
            "requires": [
                "64-bit (x86_64) Haiku.",
                "No extra packages: Isaac uses only system libraries."
            ],
            "run": [
                "Unzip, then double-click `isaac` in Tracker, or from Terminal:",
                "",
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-wayland": {
        "image": "native-wayland-sdk:24.04",
        "cmake": [
            "-DTOOLKIT=WAYLAND"
        ],
        "dockerfile": "{native}/scripts/linux/wayland",
        "package": {
            "title": "Linux (GTK 4)",
            "requires": [
                "64-bit x86 Linux with glibc 2.39 or newer (Ubuntu 24.04 or later).",
                "A Wayland or X11 desktop."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "linux-elementary": {
        "image": "native-wayland-sdk:24.04",
        "cmake": [
            "-DTOOLKIT=ELEMENTARY"
        ],
        "dockerfile": "{native}/scripts/linux/wayland",
        "package": {
            "title": "elementary OS",
            "requires": [
                "elementary OS 8, or 64-bit x86 Linux with glibc 2.39 or newer and Granite 7.",
                "A Wayland or X11 desktop."
            ],
            "run": [
                "```sh",
                "./isaac workbook.gnumeric",
                "```"
            ]
        }
    },
    "windows": {
        "image": "native-windows-winui-sdk:24.04",
        "cmake": [
            "-DCMAKE_TOOLCHAIN_FILE={native}/scripts/cmake/toolchain-mingw.cmake"
        ],
        "suffix": ".exe",
        "dockerfile": "{native}/scripts/windows/winui",
        "package": {
            "title": "Windows",
            "requires": [
                "64-bit Windows 10 or 11.",
                "[Windows App Runtime 1.8 (x64)](https://learn.microsoft.com/windows/apps/windows-app-sdk/downloads). Install it once; Isaac will not start without it."
            ],
            "run": [
                "Unzip the folder and run `isaac.exe`. Keep the DLLs beside it."
            ]
        }
    },
    "macos": {
        "host": "Darwin",
        "runner": "macos-15",
        "cmake": [
            "-DCMAKE_OSX_ARCHITECTURES=arm64;x86_64",
            "-DCMAKE_OSX_DEPLOYMENT_TARGET=13.0"
        ],
        "bundle": "Isaac.app",
        "package": {
            "title": "macOS",
            "requires": [
                "macOS 13 Ventura or newer, on Apple silicon or Intel (universal binary)."
            ],
            "run": [
                "Drag `Isaac.app` to Applications, or run it from this folder.",
                "",
                "The app is not signed with an Apple Developer ID, so macOS blocks the",
                "first launch. Either Control-click `Isaac.app`, choose **Open**, then",
                "**Open** again; or, on macOS 15 and later, open it once, then allow it in",
                "**System Settings > Privacy & Security > Open Anyway**. From Terminal:",
                "",
                "```sh",
                "xattr -dr com.apple.quarantine Isaac.app",
                "open Isaac.app",
                "```"
            ]
        }
    }
}
